{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "analyze": "cross-env ANALYZE=true next build",
    "blog:new": "node scripts/content-automation.mjs blog:new",
    "blog:publish": "node scripts/content-automation.mjs blog:publish",
    "content:validate": "node scripts/content-automation.mjs content:validate",
    "automation:check": "pnpm content:validate && pnpm proof:validate && vitest run src/lib/__tests__/blog.test.ts tests/scripts/content-automation.test.ts",
    "proof:maintenance": "node scripts/proof-maintenance-report.mjs",
    "proof:validate": "node scripts/proof-validate.mjs",
    "proof:handoff": "node scripts/proof-handoff.mjs",
    "proof:export": "node scripts/proof-export.mjs",
    "proof:bundle": "node scripts/proof-bundle.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "media:check": "node scripts/optimize-media.mjs --check",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "semantic:build": "node scripts/build-semantic-index.mjs",
    "agent:check": "node scripts/check-agent-readiness.mjs",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "decks:build": "node scripts/build-role-decks.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "feed": "^5.2.0",
    "geist": "1.3.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "next": "15.5.29",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.29",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
