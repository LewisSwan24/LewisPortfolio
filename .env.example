# Site URL for production
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form endpoint (e.g., Formspree, Getform, Basin, etc.)
# Formspree: https://formspree.io/f/your-form-id
# Getform: https://getform.io/f/your-form-id
# Basin: https://usebasin.com/f/your-form-id
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Supabase (Postgres + Auth)
# Get from https://app.supabase.com/project/_/settings/api and /settings/database
DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST]:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Giscus (GitHub Discussions-backed blog comments)
# Configure at https://giscus.app after enabling Discussions on the repo
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Internal proof maintenance route (local/dev only)
NEXT_PUBLIC_ENABLE_PROOF_MAINTENANCE=false
